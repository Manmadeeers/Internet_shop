FROM mcr.microsoft.com/dotnet/sdk:8.0-noble AS build
WORKDIR /src
COPY . .
RUN dotnet restore services/InternetShop.MessageBroker/InternetShop.MessageBroker.csproj
RUN dotnet publish services/InternetShop.MessageBroker/InternetShop.MessageBroker.csproj \
    --configuration Release --no-restore --output /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0-noble
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080
COPY --from=build /app/publish/ ./
EXPOSE 8080
ENTRYPOINT ["dotnet", "InternetShop.MessageBroker.dll"]
